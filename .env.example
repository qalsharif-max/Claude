# ---- Copy this file to ".env" and fill in your values ----

# Port the web server listens on
PORT=3000

# The single password used to log in to the app (change this!)
APP_PASSWORD=change-me-please

# A long random string used to sign the login cookie.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=replace-with-a-long-random-string

# ---- Email (Resend) ----
# Create a free account at https://resend.com, add an API key, and paste it here.
# Leave RESEND_API_KEY empty to run in "log only" mode (reminders are printed to the
# console instead of emailed) — useful for testing before you set up Resend.
RESEND_API_KEY=

# The "from" address. With Resend you can use onboarding@resend.dev to start,
# but to send to your own inbox reliably you should verify your own domain and use
# something like reminders@yourdomain.com
EMAIL_FROM=Document Reminders <onboarding@resend.dev>

# Where reminder emails are sent (comma-separated for multiple recipients).
# This can also be changed later in the app's Settings screen.
EMAIL_TO=q.alsharif@gmail.com

# ---- Reminder rules ----
# How many days before expiry the first reminder is sent (default 183 = ~6 months)
REMINDER_LEAD_DAYS=183

# How often to re-send after the first reminder, in days (default 30 = ~monthly)
REMINDER_INTERVAL_DAYS=30

# Daily time (24h, server local time) the scheduler checks for due reminders.
REMINDER_CRON_HOUR=9
REMINDER_CRON_MINUTE=0

# ---- Cloud source (optional) ----
# Auto-import documents from a cloud folder. Configure EITHER Google Drive OR
# Dropbox below. If both are set, Google Drive is used. Leave blank to disable.

# --- Option A: Google Drive (recommended) ---
# 1. In Google Cloud, create a project, enable the Google Drive API.
# 2. Create a Service Account; create a JSON key and download it.
# 3. Share your Drive folder with the service account's email (Viewer is fine).
# 4. Put the folder's ID (from its URL) below.
# Provide the key either as a file path...
GOOGLE_SERVICE_ACCOUNT_FILE=
# ...or inline (paste client_email and the private_key; keep the \n escapes):
GOOGLE_CLIENT_EMAIL=
GOOGLE_PRIVATE_KEY=
GOOGLE_DRIVE_FOLDER_ID=

# --- Option B: Dropbox ---
# Create a "scoped app" at https://www.dropbox.com/developers/apps with
# files.metadata.read + files.content.read, then generate a refresh token
# (token_access_type=offline). See README "Dropbox setup".
DROPBOX_APP_KEY=
DROPBOX_APP_SECRET=
DROPBOX_REFRESH_TOKEN=
DROPBOX_FOLDER=/Documents

# ---- AI extraction (Anthropic / Claude) ----
# Reads each document's expiry date (including Hijri) automatically.
# Get a key at https://console.anthropic.com. Leave blank to disable extraction
# (synced files still import, but you fill in their dates manually).
ANTHROPIC_API_KEY=
# Model used for extraction. Opus 4.8 (default) has the strongest vision.
EXTRACT_MODEL=claude-opus-4-8
